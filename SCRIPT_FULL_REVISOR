  # ..........................................................................................
  ##    ---- INFLUENZA - GERAL ----
  # ..........................................................................................
  
  # Criando classificação de Influenza geral (caso)
  df$influenza_geral_unico <- ifelse(df$influenza_geral_casos == 1 &
                                       df$codeteccao_casos == 0, 1, 0)
  # Verificando o total de observações
  table(df$influenza_geral_unico, df$ano)
  
  # Criando a classificação de Influenza geral (óbito)
  df$influenza_geral_obito_unico <- ifelse(df$influenza_geral_unico == 1 &
                                             df$EVOLUCAO == 2, 1, 0)
  # Verificando o total de observações
  table(df$influenza_geral_obito_unico, df$ano)
  
  # ..........................................................................................
  ##    ---- VSR (VIRUS SINCICIAL RESPIRATORIO) ----
  # ..........................................................................................
  
  # Criando classificação de VSR (caso)
  df$vsr_caso_unico <- ifelse(df$vsr_caso == 1 &
                                df$codeteccao_casos == 0, 1, 0)
  # Verificando o total de observações
  table(df$vsr_caso_unico, df$ano)
  
  # Criando a classificação de VSR (óbito)
  df$vsr_obito_unico <- ifelse(df$vsr_caso_unico == 1 & 
                                 df$EVOLUCAO == 2, 1, 0)
  # Verificando o total de observações
  table(df$vsr_obito_unico, df$ano)
  
  # ..........................................................................................
  ##    ---- ADENOVIRUS ----
  # ..........................................................................................
  
  # Criando classificação de Adenovírus (caso)
