# =============================================================================
# 2. FUNÇÃO PARA REGISTRAR AS ETAPAS DO FLUXOGRAMA ----
# =============================================================================

registrar_fluxo <- function(
    fluxo,
    etapa,
    banco_anterior,
    banco_atual
) {
  
  n_inicial <- nrow(banco_anterior)
  
  n_incluidos <- nrow(banco_atual)
  
  n_excluidos <- n_inicial - n_incluidos
  
  nova_linha <- data.frame(
    etapa = etapa,
    n_inicial = n_inicial,
    n_excluidos = n_excluidos,
    n_incluidos = n_incluidos
  )
  
  bind_rows(
    fluxo,
    nova_linha
  )
}


# =============================================================================
# 3. FUNÇÃO PARA VERIFICAR A CONSISTÊNCIA NUMÉRICA -----
# =============================================================================
#
# PARA CADA ETAPA:
#
# N_INICIAL = N_EXCLUÍDOS + N_INCLUÍDOS
#
# NA PRIMEIRA ETAPA, NÃO HÁ EXCLUSÕES, PORTANTO N_EXCLUÍDOS = NA.
# =============================================================================

verificar_fluxo <- function(fluxo) {
  
  fluxo %>%
    mutate(
      conferencia = case_when(
        is.na(n_excluidos) ~
          n_inicial == n_incluidos,
        TRUE ~
          n_inicial == n_excluidos + n_incluidos
      )
    )
}


