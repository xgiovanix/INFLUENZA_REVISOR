  ) %>%
  mutate(
    # =========================================================
    # VERSAO OPERACIONAL (compatibilidade MS/SIVEP) ----
    # =========================================================
    
    influenza = case_when(
      RES_FLUA == 1 | RES_FLUB == 1 ~ 1,
      (RES_FLUA != 1 & RES_FLUB != 1) &
        (RES_FLUA == 2 | RES_FLUB == 2) ~ 0,
      TRUE ~ NA_real_
    ),
    
    # =========================================================
    # VERSAO RIGOROSA (controle explicito de NA) ----
    # =========================================================
    
    influenza_rigorosa = case_when(
      # qualquer positivo
      RES_FLUA == 1 | RES_FLUB == 1 ~ 1,
      # ausencia de positivo + pelo menos um negativo confirmado
      !(coalesce(RES_FLUA == 1, FALSE) | coalesce(RES_FLUB == 1, FALSE)
      ) & ( RES_FLUA == 2 | RES_FLUB == 2) ~ 0,
      TRUE ~ NA_real_
    )
  )

